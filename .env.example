# Copy to .env. All optional.
OCR_PORT=8000
PADDLE=cpu                     # cpu | gpu (build arg; gpu also needs OCR_DEVICE=gpu:0)
OCR_DEVICE=cpu                 # cpu | gpu:0
# OCR_ENGINE=onnxruntime        # onnxruntime (default in the image, faster on CPU) | paddle (also use for GPU)
# OCR_DET_MODEL=PP-OCRv5_server_det
# OCR_REC_MODEL=th_PP-OCRv5_mobile_rec
# OCR_REC_DIR=                 # fine-tuned recognizer (exported inference dir) to use instead
# OCR_UNWARP=false             # UVDoc unwarping, slower
# OCR_PROVIDERS=               # onnxruntime providers (detector + ONNX OCR). Auto: CUDA if gpu, CoreML on native macOS, else CPU
# Thresholds per step (defaults shown)
# OCR_DETECTOR_CONF=0.25        # label detector: minimum box confidence
# OCR_DETECTOR_NMS_IOU=0.5      # label detector: overlap above which boxes are merged
# OCR_LOCATOR_MIN_AREA=0.15     # corner finder: smallest label, share of the crop
# OCR_CROP_PAD=0.03             # padding around the detected box before cropping
# OCR_TEXT_DET_THRESH=          # text detector pixel threshold (empty = Paddle default)
# OCR_TEXT_DET_BOX_THRESH=      # text detector box score (empty = Paddle default)
# OCR_ENABLE_DEBUG=false        # true serves /debug (step-by-step page); shows uploaded images, demo only
# OCR_MIN_SCORE=0.5             # recognizer: drop lines scoring below this
