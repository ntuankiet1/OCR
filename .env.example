# Copy to .env. All optional.
OCR_PORT=8000
PADDLE=cpu                     # cpu | gpu (build arg; gpu also needs OCR_DEVICE=gpu:0)
OCR_DEVICE=cpu                 # cpu | gpu:0
# OCR_DET_MODEL=PP-OCRv5_server_det
# OCR_REC_MODEL=th_PP-OCRv5_mobile_rec
# OCR_REC_DIR=                 # fine-tuned recognizer (exported inference dir) to use instead
# OCR_UNWARP=false             # UVDoc unwarping, slower
# OCR_MIN_SCORE=0.5
