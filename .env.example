# Copy to .env and change every secret before sharing the stack with anyone.

# --- Postgres (MLflow backend, Label Studio, feedback store)
POSTGRES_USER=parcel
POSTGRES_PASSWORD=change-me-postgres

# --- S3-compatible object storage (SeaweedFS). Used by DVC, MLflow artifacts and the image store.
S3_ACCESS_KEY=parcel-admin
S3_SECRET_KEY=change-me-s3-secret

# --- Label Studio initial admin
LABEL_STUDIO_USERNAME=admin@parcel-ocr.local
LABEL_STUDIO_PASSWORD=change-me-labelstudio

# --- Host ports
MLFLOW_PORT=5000
LABEL_STUDIO_PORT=8080
S3_PORT=8333

# --- Training image variant: cpu | gpu  (gpu also needs docker-compose.gpu.yml)
TRAIN_VARIANT=cpu
